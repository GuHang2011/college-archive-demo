# Server only. Never prefix provider keys or access codes with VITE_.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
# A separate, long random access code for the assistant gateway (not the provider key).
AI_ACCESS_TOKEN=
AI_HOURLY_LIMIT=60
# Exact frontend origin, no path. Required for a public frontend or reverse proxy.
AI_ALLOWED_ORIGINS=https://guhang2011.github.io
HOST=127.0.0.1
PORT=4175
# Optional public gateway address embedded at build time; this is NOT an API key.
# VITE_AI_GATEWAY=https://assistant.example.com
# Collaboration uses the same Node server; keep this directory outside public assets.
# COLLAB_DATA_DIR=/var/lib/college-archive
# VITE_COLLAB_GATEWAY=https://team.example.com
