{
  "name": "college-archive-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "setup:ai": "node scripts/setup-ai.mjs",
    "setup:collaboration": "node --env-file-if-exists=.env scripts/setup-collaboration.mjs",
    "test:assistant": "node --test scripts/test-assistant.mjs",
    "test:collaboration": "node --test scripts/test-collaboration.mjs",
    "test:collaboration:browser": "node scripts/verify-collaboration.cjs",
    "test:assistant:browser": "node scripts/verify-assistant.cjs",
    "test:browser": "node scripts/verify-demo.cjs",
    "test:interface": "node scripts/verify-interface.cjs",
    "test:photography": "node scripts/verify-photography.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "element-plus": "2.2.26",
    "vue": "3.2.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "4.0.0",
    "typescript": "4.9.4",
    "vite": "4.0.0",
    "vue-tsc": "^1.8.27"
  }
}
